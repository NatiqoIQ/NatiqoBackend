# ==============================================================================
# Natiqo backend — example environment. Copy to .env and fill real values.
# NEVER commit a populated .env.
# ==============================================================================

# ------------------------------------------------------------------ runtime
APP_ENV=development                 # development | testing | staging | production
APP_NAME=Natiqo API
API_V1_PREFIX=/api/v1
DEBUG=false
HOST=0.0.0.0
PORT=8000

# ----------------------------------------------------------------- database
# PostgreSQL is the only supported production database.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=natiqo
POSTGRES_PASSWORD=change-me
POSTGRES_DB=natiqo
# Full override wins over the discrete POSTGRES_* values above.
# DATABASE_URL=postgresql+asyncpg://natiqo:change-me@127.0.0.1:5432/natiqo
DATABASE_URL=
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800
DATABASE_ECHO=false

# ------------------------------------------------------------------- redis
# Left empty -> in-memory cache/queue adapters are used (development/tests).
REDIS_URL=
CACHE_TTL_SECONDS=300
QUEUE_ENABLED=false

# ------------------------------------------------------------- security/jwt
# Generate with: python -c "import secrets;print(secrets.token_urlsafe(64))"
JWT_SECRET=dev-only-access-secret-change-me-0000000000000000000000
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me-00000000000000
JWT_ALGORITHM=HS256
JWT_ISSUER=natiqo
JWT_AUDIENCE=natiqo-clients
ACCESS_TOKEN_TTL_SECONDS=900          # 15 minutes
REFRESH_TOKEN_TTL_SECONDS=2592000     # 30 days

# ---------------------------------------------------- development sign-in
# POST /api/v1/auth/dev-login with a fixed username/password — the only
# credential check the service performs, for local development and QA without a
# provider client id. Sessions minted through it last DEV_LOGIN_TOKEN_TTL_SECONDS,
# so a test run never hits a 15-minute expiry; every other sign-in keeps the TTLs
# above. Leave false unless you need it, and NEVER set it in production: the route
# is not mounted when false, and validate_environment() refuses to boot a
# production process with it enabled.
DEV_LOGIN_ENABLED=false
DEV_ADMIN_USER=admin
DEV_ADMIN_PASSWORD=admin
DEV_LOGIN_TOKEN_TTL_SECONDS=315360000 # 10 years

# --------------------------------------------------- social sign-in (google/apple)
# Accepted ID-token audiences: the OAuth *client ids* of every app that signs in.
# A token minted for one client is rejected by another, so a token lifted from an
# attacker-controlled app cannot be replayed here. Comma separated, or a JSON array.
# A provider with no client ids is not offered: its endpoint answers 401
# AUTH_PROVIDER_UNAVAILABLE instead of trusting anything. At least one of the two is
# required in production.
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=
# Where the signing keys are published. The verified token is never stored, and the
# provider is never called on the learner's behalf: only signature, issuer, audience
# and expiry are checked, against keys cached for JWKS_CACHE_SECONDS.
GOOGLE_JWKS_URL=https://www.googleapis.com/oauth2/v3/certs
APPLE_JWKS_URL=https://appleid.apple.com/auth/keys
JWKS_CACHE_SECONDS=3600

# --------------------------------------------------------------------- cors
# Comma separated exact origins. Never use "*" with credentials.
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:8000
CORS_ALLOW_CREDENTIALS=true

# ------------------------------------------------------------------- limits
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=120
RATE_LIMIT_AUTH_REQUESTS_PER_MINUTE=10
RATE_LIMIT_CATALOGUE_REQUESTS_PER_MINUTE=240
MAX_REQUEST_BODY_BYTES=1048576

# -------------------------------------------------------- object storage
# S3-compatible (AWS S3, MinIO, Cloudflare R2, ...). Empty -> local filesystem.
S3_ENDPOINT=
S3_REGION=eu-west-2
S3_BUCKET=natiqo-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
SIGNED_URL_TTL_SECONDS=900
LOCAL_STORAGE_PATH=./media_local

# --------------------------------------------------------------------- fcm
# Firebase Cloud Messaging. Empty -> no-op push adapter (development).
FCM_CREDENTIALS_JSON=
FCM_PROJECT_ID=

# ---------------------------------------------------------------------- ai
# AI is strictly optional. Empty -> deterministic local fallbacks only.
AI_ENABLED=false
AI_PROVIDER=none                   # none | openai | anthropic
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SECONDS=20
AI_MAX_INPUT_CHARS=4000
AI_MAX_OUTPUT_TOKENS=800
AI_DAILY_USER_BUDGET_USD=0.50

# -------------------------------------------------------------- payments
PAYMENT_PROVIDER=none              # none | stripe
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=
CURRENCY=IQD

# -------------------------------------------------------------- gamification
MAX_HEARTS=5
HEART_REGEN_SECONDS=1800
PREMIUM_UNLIMITED_HEARTS=true
DAILY_GOAL_DEFAULT=30

# ------------------------------------------------------------ observability
LOG_LEVEL=INFO
LOG_FORMAT=json                   # json | console
OTEL_ENABLED=false
OTEL_SERVICE_NAME=natiqo-api
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=

# ------------------------------------------------------------ local testing
# When true, tests may use aiosqlite instead of PostgreSQL.
ALLOW_SQLITE_TESTS=false
