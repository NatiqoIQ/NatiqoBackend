              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"device\": {\n    \"platform\": \"ios\",\n    \"push_token\": \"pm-device-token-0002\",\n    \"app_version\": \"1.1.0\"\n  }\n}"
            },
            "url": {
