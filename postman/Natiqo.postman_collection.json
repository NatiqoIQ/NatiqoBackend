{
  "info": {
    "_postman_id": "b7f3c1a2-4d5e-4f60-9a1b-2c3d4e5f6a7b",
    "name": "Natiqo API",
    "description": "Every endpoint the backend currently exposes, with the negative cases that matter for auth.\n\nThree things to know before editing:\n- 20 requests, 56 assertions. `../run.ps1` runs the folders in order and fails the build on the first broken assertion.\n- Variables live in the environment file, not on the collection. Collection-level variables shadow globals in Postman, so a value set with `--global-var` is silently ignored; `run.ps1` passes `--env-var` and the scripts read and write with `pm.environment`.\n- Sign-in needs an ID token from Google or Apple, which no test client can mint. `run.ps1` therefore mints a real session through the real `login_with_identity` use case with `../mint_session.py`, and the collection covers the *rejection* paths for tokens it cannot forge.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Health",
      "description": "Unversioned probes. Orchestrators call these directly.",
      "item": [
        {
          "name": "Liveness",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "Process is up. Must not touch the database."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('reports healthy', () => pm.expect(b.data.status).to.eql('healthy'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Readiness",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/ready",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ready"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('reports every check', () => pm.expect(b.data.checks).to.be.an('array'));",
                  "const db = b.data.checks.find(c => c.name === 'database');",
                  "pm.test('database reachable', () => { pm.expect(db).to.be.an('object'); pm.expect(db.status).to.eql('healthy'); });",
                  "pm.test('cache is honest about being in-process', () => { const c = b.data.checks.find(x => x.name === 'cache'); pm.expect(c.status).to.be.oneOf(['healthy', 'degraded', 'unhealthy']); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Auth",
      "description": "Sign-in, refresh rotation and logout. There is no register, login, forgot-password or change-password endpoint any more: all four answer 404.",
      "item": [
        {
          "name": "Sign in with Google (forged token is refused)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id_token\": \"a-token-nobody-signed\",\n  \"device\": {\n    \"platform\": \"android\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/google",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "google"
              ]
            },
            "description": "401. The signature is checked against Google's published keys before anything is read or written, so a token this client made up signs nobody in."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401', () => pm.response.to.have.status(401));",
                  "const b = pm.response.json();",
                  "pm.test('code is AUTH_IDENTITY_INVALID', () => pm.expect(b.error.code).to.eql('AUTH_IDENTITY_INVALID'));",
                  "pm.test('carries a requestId for support', () => pm.expect(b.error.requestId).to.be.a('string'));",
                  "pm.test('no tokens in the body', () => pm.expect(pm.response.text()).to.not.include('accessToken'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Sign in with Apple (forged token is refused)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id_token\": \"a-token-nobody-signed\",\n  \"device\": {\n    \"platform\": \"ios\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/apple",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "apple"
              ]
            },
            "description": "401. Same contract, different issuer and key set. Which endpoint was called decides which keys are used."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401', () => pm.response.to.have.status(401));",
                  "pm.test('rejected, or the provider is not configured here', () => pm.expect(pm.response.json().error.code).to.be.oneOf(['AUTH_IDENTITY_INVALID', 'AUTH_PROVIDER_UNAVAILABLE']));"
                ]
              }
            }
          ]
        },
        {
          "name": "Sign in (token is required)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id_token\": \"too-short\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/google",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "google"
              ]
            },
            "description": "422. The token has a floor as well as a ceiling: an 8 KiB body is an attack, not a credential."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('422', () => pm.response.to.have.status(422));",
                  "const b = pm.response.json();",
                  "pm.test('code is VALIDATION_ERROR', () => pm.expect(b.error.code).to.eql('VALIDATION_ERROR'));",
                  "pm.test('names the offending field', () => pm.expect(b.error.details.fields[0].field).to.eql('id_token'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refreshToken}}\",\n  \"device\": {\n    \"platform\": \"web\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/refresh",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "refresh"
              ]
            },
            "description": "200. Rotation: the presented token is consumed and a new pair is issued. Needs the session minted by run.ps1."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const previous = pm.environment.get('refreshToken');\n                  pm.environment.set('usedRefreshToken', previous);",
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('issues a different refresh token', () => pm.expect(b.tokens.refreshToken).to.not.eql(previous));",
                  "pm.test('access token is usable', () => pm.expect(b.tokens.accessToken).to.be.a('string'));",
                  "pm.environment.set('accessToken', b.tokens.accessToken);",
                  "pm.environment.set('refreshToken', b.tokens.refreshToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh (a replayed token revokes the family)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{usedRefreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/refresh",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "refresh"
              ]
            },
            "description": "401. Presenting an already-rotated token means it was copied, so the whole rotation chain is killed rather than just the token presented. `usedRefreshToken` is captured by the Refresh test above."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401', () => pm.response.to.have.status(401));",
                  "pm.test('code is AUTH_REFRESH_REUSED', () => pm.expect(pm.response.json().error.code).to.eql('AUTH_REFRESH_REUSED'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refreshToken2}}\",\n  \"all_devices\": false\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "logout"
              ]
            },
            "description": "200. Idempotent by design, so a retry after a dropped response still reports success. It uses a *second* chain minted by run.ps1, so revoking it cannot disturb the tokens the rest of the run is using."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('reports the outcome', () => pm.expect(pm.response.json().detail).to.be.a('string'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout (the revoked chain is dead)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refreshToken2}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/refresh",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "refresh"
              ]
            },
            "description": "401. Proves Logout actually revoked the chain rather than only clearing the client's copy."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401', () => pm.response.to.have.status(401));",
                  "pm.test('code is AUTH_REFRESH_REUSED', () => pm.expect(pm.response.json().error.code).to.eql('AUTH_REFRESH_REUSED'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Me",
      "item": [
        {
          "name": "Get me",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "me"
              ]
            },
            "description": "200. The account is created by the sign-in, so nothing has to register first."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('the session belongs to the minted account', () => pm.expect(b.email).to.eql(pm.environment.get('email')));",
                  "pm.test('account is active', () => pm.expect(b.status).to.eql('active'));",
                  "pm.test('baseline account is not an admin', () => pm.expect(b.isAdmin).to.eql(false));",
                  "pm.test('emailVerified reflects the provider', () => pm.expect(b.emailVerified).to.be.a('boolean'));",
                  "pm.test('currentLevel is set by placement, not the client', () => pm.expect(b.profile.currentLevel).to.be.a('string'));",
                  "pm.test('no token leaks into the profile', () => pm.expect(pm.response.text()).to.not.include('eyJ'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get me (no token)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "me"
              ]
            },
            "description": "401. A missing credential is not a worse error than a bad one."
