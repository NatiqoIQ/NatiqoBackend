                ]
              }
            }
          ]
        },
        {
          "name": "Update me",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"display_name\": \"Alina H.\",\n  \"timezone\": \"Asia/Baghdad\",\n  \"daily_goal_minutes\": 45,\n  \"notification_preferences\": {\n    \"weekly_report\": true\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "me"
              ]
            },
            "description": "200. PATCH semantics: every field is optional, and one that is not sent keeps its stored value."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('displayName applied', () => pm.expect(b.profile.displayName).to.eql('Alina H.'));",
                  "pm.test('daily goal applied', () => pm.expect(b.settings.dailyGoalMinutes).to.eql(45));",
                  "pm.test('a preference in the patch applied', () => pm.expect(b.settings.notificationPreferences.weeklyReport).to.be.true);",
                  "pm.test('an untouched channel keeps its stored value', () => pm.expect(b.settings.notificationPreferences.email).to.be.a('boolean'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Update me (current_level is refused)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"current_level\": \"C2\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "me"
              ]
            },
            "description": "422. The field is absent from the schema on purpose: a learner who could set their own level would bypass the placement test every later difficulty decision assumes."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('422', () => pm.response.to.have.status(422));",
                  "const b = pm.response.json();",
                  "pm.test('code is VALIDATION_ERROR', () => pm.expect(b.error.code).to.eql('VALIDATION_ERROR'));",
                  "pm.test('names current_level', () => pm.expect(JSON.stringify(b.error.details)).to.include('current_level'));"
                ]
              }
            }
          ]
        },
        {
          "name": "List devices",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/me/devices",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "me",
                "devices"
              ]
            },
            "description": "200. The minted session carries an android device, so there is one row to list and revoke."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const devices = pm.response.json();",
                  "pm.test('returns an array', () => pm.expect(devices).to.be.an('array'));",
