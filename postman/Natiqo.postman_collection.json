{
  "info": {
    "_postman_id": "b7f3c1a2-4d5e-4f60-9a1b-2c3d4e5f6a7b",
    "name": "Natiqo API",
    "description": "Every endpoint the backend currently exposes, with the negative cases that matter for auth.\n\nTwo things to know before editing:\n- 26 requests, 65 assertions. `../run.ps1` runs the folders in order and fails the build on the first broken assertion.\n- Variables live in the environment file, not on the collection. Collection-level variables shadow globals in Postman, so a value set with `--global-var` is silently ignored; `run.ps1` passes `--env-var` and the scripts read and write with `pm.environment`.\n\nPassword reset is a separate folder because the token only ever leaves the system through the mail provider. `run.ps1` mints one through the real forgot_password use case rather than the API growing a debug endpoint.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Health",
      "description": "Unversioned probes. Orchestrators call these directly.",
      "item": [
        {
          "name": "Liveness",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "Process is up. Must not touch the database."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('reports healthy', () => pm.expect(b.data.status).to.eql('healthy'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Readiness",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/ready",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ready"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('reports every check', () => pm.expect(b.data.checks).to.be.an('array'));",
                  "const db = b.data.checks.find(c => c.name === 'database');",
                  "pm.test('database reachable', () => { pm.expect(db).to.be.an('object'); pm.expect(db.status).to.eql('healthy'); });",
                  "pm.test('cache is honest about being in-process', () => { const c = b.data.checks.find(x => x.name === 'cache'); pm.expect(c.status).to.be.oneOf(['healthy', 'degraded', 'unhealthy']); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"display_name\": \"Alina Haddad\",\n  \"native_language\": \"ar\",\n  \"english_variant\": \"british\",\n  \"timezone\": \"Asia/Baghdad\",\n  \"locale\": \"en-GB\",\n  \"device\": {\n    \"platform\": \"android\",\n    \"push_token\": \"pm-device-token-0001\",\n    \"app_version\": \"1.0.0\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "register"
              ]
            },
            "description": "201 on success. A device block is optional; without both push_token and app_version no durable device row is written."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201', () => pm.response.to.have.status(201));",
                  "const b = pm.response.json();",
                  "pm.test('has user and tokens', () => { pm.expect(b.user).to.be.an('object'); pm.expect(b.tokens).to.be.an('object'); });",
                  "pm.test('token type is Bearer', () => pm.expect(b.tokens.token_type).to.eql('Bearer'));",
                  "pm.test('current_level is set by placement, not the client', () => pm.expect(b.user.profile.current_level).to.be.a('string'));",
                  "pm.test('no plaintext token leaks into the profile', () => pm.expect(JSON.stringify(b.user)).to.not.include(b.tokens.access_token));",
                  "pm.environment.set('accessToken', b.tokens.access_token);",
                  "pm.environment.set('refreshToken', b.tokens.refresh_token);"
                ]
              }
            }
          ]
        },
        {
