        {
          "name": "Login (wrong password)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"Wrong-Password-9999\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "description": "401. The failed-attempt counter is committed even though the request fails. The message must stay symmetric so a wrong password is indistinguishable from an unknown account."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401', () => pm.response.to.have.status(401));",
                  "const b = pm.response.json();",
                  "pm.test('message is symmetric, not a hint about which field was wrong', () => pm.expect(b.error.message.toLowerCase()).to.eql('email or password is incorrect.'));",
                  "pm.test('no tokens in the body', () => pm.expect(pm.response.text()).to.not.include('access_token'));",
                  "pm.test('carries a request_id for support', () => pm.expect(b.error.request_id).to.be.a('string'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refreshToken}}\",\n  \"device\": {\n    \"platform\": \"web\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/refresh",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "refresh"
              ]
            },
            "description": "200. Rotation: the presented token is consumed and a new pair is issued."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const previous = pm.environment.get('refreshToken');\n                  pm.environment.set('usedRefreshToken', previous);",
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('issues a different refresh token', () => pm.expect(b.tokens.refresh_token).to.not.eql(previous));",
                  "pm.environment.set('accessToken', b.tokens.access_token);",
                  "pm.environment.set('refreshToken', b.tokens.refresh_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh (reused token revokes the family)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{usedRefreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/refresh",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "refresh"
              ]
            },
            "description": "401. Replay of an already-rotated token means it was copied, so the whole family is killed. Run this with the token captured before the Refresh test rotated it."
          },
          "event": [
