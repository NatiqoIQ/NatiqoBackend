                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('body does not leak a token', () => pm.expect(pm.response.text().toLowerCase()).to.not.include('token'));",
                  "pm.environment.set('forgotKnownBody', pm.response.text());"
                ]
              }
            }
          ]
        },
        {
