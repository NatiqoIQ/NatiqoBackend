    {
      "name": "Password reset (needs a real token)",
      "description": "Run after `Mint reset token` has written the raw token. These requests are separated from the Auth folder precisely because the token cannot be obtained from an API response.",
      "item": [
        {
          "name": "Reset password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{resetToken}}\",\n  \"new_password\": \"{{newPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/reset-password",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "reset-password"
              ]
            },
            "description": "200. `resetToken` is injected by run.ps1 from the real forgot_password use case, standing in for the mail provider. Revokes every session as a side effect."
          },
          "event": [
