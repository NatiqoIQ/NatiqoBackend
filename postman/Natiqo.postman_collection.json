          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401', () => pm.response.to.have.status(401));",
                  "pm.test('code is AUTH_TOKEN_INVALID', () => pm.expect(pm.response.json().error.code).to.eql('AUTH_TOKEN_INVALID'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get me (garbage token)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer not-a-jwt"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
